{
  "name": "tpt-microlog",
  "version": "0.1.0",
  "description": "The microscopic telemetry & log router. Guaranteed delivery, zero infrastructure.",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/tpt-solutions/tpt-microlog"
  },
  "authors": [
    "TPT Solutions"
  ],
  "keywords": [
    "logging",
    "metrics",
    "telemetry",
    "observability",
    "datadog",
    "browser",
    "webassembly",
    "structured-logging",
    "batching",
    "compression",
    "frontend",
    "analytics",
    "sendbeacon",
    "performance",
    "developer-tools",
    "monitoring",
    "opentelemetry",
    "zero-config"
  ],
  "type": "module",
  "main": "dist/tpt_log_wasm.js",
  "types": "index.d.ts",
  "files": [
    "dist",
    "index.d.ts",
    "pino.js",
    "pino.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/tpt_log_wasm.js",
      "default": "./dist/tpt_log_wasm.js"
    },
    "./pino": {
      "types": "./pino.d.ts",
      "import": "./pino.js",
      "default": "./pino.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
